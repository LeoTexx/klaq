# Optional: ElevenLabs voice-over (`pnpm tts`). Copy to `.env` and fill in; `.env` is gitignored.
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional. Leave blank for the built-in default; `pnpm tts --list-voices` lists voices.
ELEVENLABS_VOICE_ID=

# Optional. eleven_multilingual_v2 handles most languages well.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
