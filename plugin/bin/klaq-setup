#!/usr/bin/env bash
# klaq-setup: create or update the Klaq workspace (a clone of the repo where your projects live).
#   klaq-setup              first install: clone, install packages, check tools, pull Remotion docs
#   klaq-setup --update     git pull the engine, reinstall packages if the lockfile changed
#   klaq-setup --check      only report which tools are present
#   klaq-setup --skip-docs  don't pull the Remotion docs (about 7 MB of Markdown)
# Workspace: $KLAQ_HOME, default ~/klaq. Your projects/, public/projects/, work/ and out/ are gitignored,
# so updating never touches your work.
set -euo pipefail
REPO="${KLAQ_REPO:-https://github.com/LeoTexx/klaq.git}"
HOME_DIR="${KLAQ_HOME:-$HOME/klaq}"
MODE=install; DOCS=1
for a in "$@"; do case "$a" in --update) MODE=update ;; --check) MODE=check ;; --skip-docs) DOCS=0 ;; -h|--help) sed -n 2,9p "$0"; exit 0 ;; esac; done

ok() { printf '  \033[32m✓\033[0m %s\n' "$1"; }
miss() { printf '  \033[33m•\033[0m %s\n' "$1"; }
check_tools() {
  echo "Tools:"
  if command -v node >/dev/null && [ "$(node -p 'process.versions.node.split(".")[0]')" -ge 20 ]; then ok "node $(node -v)"; else miss "Node.js 20+ (required): https://nodejs.org"; NEED=1; fi
  if command -v pnpm >/dev/null; then ok "pnpm $(pnpm -v)"; else miss "pnpm (required): corepack enable && corepack prepare pnpm@9 --activate"; NEED=1; fi
  if command -v ffmpeg >/dev/null; then ok "ffmpeg"; else miss "ffmpeg (required for editing and checks): brew install ffmpeg / apt install ffmpeg"; NEED=1; fi
  if command -v whisper >/dev/null; then ok "whisper (transcription for edits)"; else miss "whisper (optional, for editing recordings): pipx install openai-whisper"; fi
  if [ "$(uname)" = Darwin ]; then
    if command -v swiftc >/dev/null; then ok "swiftc (head tracking)"; else miss "swiftc (optional, head tracking on macOS): xcode-select --install"; fi
  else miss "head tracking uses Apple Vision (macOS only); elsewhere framing falls back to a fixed face position"; fi
  if command -v yt-dlp >/dev/null; then ok "yt-dlp (reference videos)"; else miss "yt-dlp (optional, to analyse reference videos by URL)"; fi
}

NEED=0
if [ "$MODE" = check ]; then check_tools; exit 0; fi
echo "Klaq workspace: $HOME_DIR"
is_klaq() { [ -f "$1/package.json" ] && grep -q '"name": "klaq"' "$1/package.json"; }
if [ ! -d "$HOME_DIR/.git" ] && is_klaq "$HOME_DIR"; then
  echo "Using the existing Klaq folder (not a git clone, so --update can't pull; re-download to update)."
elif [ ! -d "$HOME_DIR/.git" ]; then
  [ "$MODE" = update ] && { echo "No workspace yet; run klaq-setup first."; exit 1; }
  [ -e "$HOME_DIR" ] && [ -n "$(ls -A "$HOME_DIR" 2>/dev/null)" ] && { echo "$HOME_DIR exists and is not a Klaq workspace. Set KLAQ_HOME to another folder."; exit 1; }
  git clone --depth 1 "$REPO" "$HOME_DIR"
else
  before=$(git -C "$HOME_DIR" rev-parse HEAD)
  git -C "$HOME_DIR" pull --ff-only
  [ "$before" = "$(git -C "$HOME_DIR" rev-parse HEAD)" ] && echo "Engine already up to date."
fi
check_tools
[ "$NEED" = 1 ] && { echo; echo "Install the required tools above, then run klaq-setup again."; exit 1; }
cd "$HOME_DIR"
pnpm install --frozen-lockfile
pnpm -s registry
if [ "$DOCS" = 1 ] && [ -z "$(ls -A docs/remotion 2>/dev/null)" ]; then pnpm -s pull-docs || echo "  (docs pull failed; Klaq works without them, retry with: pnpm pull-docs)"; fi
mkdir -p "$HOME/.config/klaq" && printf '%s\n' "$HOME_DIR" > "$HOME/.config/klaq/home"
echo
echo "Ready. In Claude Code, type /klaq. Studio: cd $HOME_DIR && pnpm studio"
